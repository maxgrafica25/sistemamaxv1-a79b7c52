# =============================================================================
# .env.example — template para deploy em VPS (Supabase self-hosted + frontend)
# =============================================================================
# Copie para .env e preencha com valores reais. NÃO comite o .env.
# Documentação completa: docs/deployment-vars.md
# =============================================================================

# ---- Frontend (build-time, injetado via Docker ARG) ----
VITE_SUPABASE_URL=https://api.seudominio.com
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIs...   # = ANON_KEY abaixo
VITE_SUPABASE_PROJECT_ID=self-hosted

# ---- Postgres ----
POSTGRES_PASSWORD=troque-isto-openssl-rand-base64-32
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ---- JWT (compartilhado entre auth/rest/realtime/storage) ----
JWT_SECRET=troque-isto-openssl-rand-base64-64
JWT_EXP=3600
ANON_KEY=eyJhbGciOiJIUzI1NiIs...           # gerar via scripts/generate-jwt.ts
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...   # gerar via scripts/generate-jwt.ts

# ---- Auth (GoTrue) ----
SITE_URL=https://app.seudominio.com
ADDITIONAL_REDIRECT_URLS=
DISABLE_SIGNUP=false
GOTRUE_RATE_LIMIT_EMAIL_SENT=300
GOTRUE_SMTP_HOST=smtp.resend.com
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=resend
GOTRUE_SMTP_PASS=re_xxx
GOTRUE_SMTP_ADMIN_EMAIL=no-reply@seudominio.com
GOTRUE_SMTP_SENDER_NAME=Sistema

# ---- MinIO (S3 self-hosted) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=troque-isto-openssl-rand-base64-24
STORAGE_S3_ACCESS_KEY=storage-access-key
STORAGE_S3_SECRET_KEY=storage-secret-key
STORAGE_S3_BUCKET=storage
STORAGE_S3_REGION=us-east-1

# ---- Edge Functions (secrets de runtime) ----
BROWSERLESS_API_KEY=
FIRECRAWL_API_KEY=
LOVABLE_API_KEY=
VPS_WORKER_TOKEN=

# ---- Caddy (TLS / domínios) ----
CADDY_DOMAIN_APP=app.seudominio.com
CADDY_DOMAIN_API=api.seudominio.com
CADDY_ACME_EMAIL=admin@seudominio.com
